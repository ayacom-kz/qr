# ===== Скопируй этот файл в .env и заполни значения =====

# Строка подключения к Supabase (Postgres).
# Supabase → Project Settings → Database → Connection string → URI
# Пример: postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Секрет для подписи JWT-токенов (придумай длинную случайную строку)
JWT_SECRET=

# Базовый адрес, который зашивается в QR-код.
# Локально: http://localhost:3000
# На проде: https://твой-домен
BASE_URL=http://localhost:3000

# Порт (на хостингах обычно задаётся автоматически)
PORT=3000
